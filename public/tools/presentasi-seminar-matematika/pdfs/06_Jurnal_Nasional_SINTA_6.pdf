rg/records/7813406", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:7813406/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:7813406/sequence/default", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:7813406:6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf/full/%5E10,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:7813406:6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf/full/%5E100,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:7813406:6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf/full/%5E1200,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:7813406:6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf/full/%5E250,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:7813406:6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf/full/%5E50,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:7813406:6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf/full/%5E750,/0/default.jpg"}, "versions": "https://zenodo.org/api/records/7813406/versions"}, "media_files": {"count": 1, "enabled": true, "entries": {"6. Pembelajaran Berdiferensiasi (Diah A PPG).pdf.ptif": {"access": {"hidden": true}, "ext": "ptif", "id": "eeebeab9-882a-4259-8240-0b8e0bdbac88", "key": "6. Pembelajaran Berdiferensiasi (Diah A PPG).pdf.ptif", "links": {"content": "https://zenodo.org/api/records/7813406/files/6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf.ptif/content", "self": "https://zenodo.org/api/records/7813406/files/6.%20Pembelajaran%20Berdiferensiasi%20(Diah%20A%20PPG).pdf.ptif"}, "metadata": null, "mimetype": "application/octet-stream", "processor": {"source_file_id": "4f0e77df-8322-43c8-90ff-b5f55fe8c0b3", "status": "finished", "type": "image-tiles"}, "size": 0, "storage_class": "L"}}, "order": [], "total_bytes": 0}, "metadata": {"creators": [{"affiliations": [{"name": "Universitas PGRI Mahadewa Indonesia"}], "person_or_org": {"family_name": "Ni Putu Diah Apriyantini", "name": "Ni Putu Diah Apriyantini", "type": "personal"}}, {"affiliations": [{"name": "Universitas PGRI Mahadewa Indonesia"}], "person_or_org": {"family_name": "I Komang Sukendra", "name": "I Komang Sukendra", "type": "personal"}}], "description": "\u003cp\u003e\u003cem\u003eDifferentiated learning is learning that is designed with the aim of facilitating all the diversity of students based on the learning needs and characteristics of students in learning activities. E-LKPD in the form ofLive Worksheet is one of the media assisted by electronic media which contains text, images, animations, and videos that are more effective so that students don\u0026#39;t get bored quickly. The purpose of this study was to find out whether the application of E-LKPD-assisted differentiated learning can increase students\u0026#39; active learning in mathematics. This type of research is Classroom Action Research. The subjects of this research were class VIII.2 students of SMP Negeri 6 Denpasar in the academic year 2022/2023 and the object of this research was the activeness of students learning mathematics. In this research through two cycles consisting of four stages of the activity process which includes (1) planning, (2) action, (3) observation, and (4) evaluation and reflection. Data collection techniques using the observation method. The results of the study show that the application of E-LKPD-assisted differentiated learning can increase the activeness of learning mathematics in class VIII.2 students of SMP Negeri 6 Denpasar in the 2022/2023 academic year.\u003c/em\u003e\u003c/p\u003e", "publication_date": "2023-04-10", "publisher": "Zenodo", "resource_type": {"id": "publication-article", "title": {"de": "Zeitschriftenartikel", "en": "Journal article"}}, "rights": [{"description": {"en": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited."}, "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title": {"en": "Creative Commons Attribution 4.0 International"}}], "subjects": [{"subject": "differentiated learning"}, {"subject": "E-LKPD"}, {"subject": "learning activities"}], "title": "PENERAPAN PEMBELAJARAN BERDIFERENSIASI BERBANTUAN  E-LKPD UNTUK MENINGKATKAN KEAKTIFAN BELAJAR MATEMATIKA SISWA"}, "parent": {"access": {"owned_by": {"user": "135917"}, "settings": {"accept_conditions_text": null, "allow_guest_requests": false, "allow_user_requests": false, "secret_link_expiration": 0}}, "communities": {}, "id": "7813405", "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.7813405", "provider": "datacite"}}}, "pids": {"doi": {"client": "datacite", "identifier": "10.5281/zenodo.7813406", "provider": "datacite"}, "oai": {"identifier": "oai:zenodo.org:7813406", "provider": "oai"}}, "revision_id": 5, "stats": {"all_versions": {"data_volume": 46364400.0, "downloads": 225, "unique_downloads": 196, "unique_views": 240, "views": 257}, "this_version": {"data_volume": 45952272.0, "downloads": 223, "unique_downloads": 195, "unique_views": 238, "views": 255}}, "status": "published", "swh": {}, "ui": {"access_status": {"description_l10n": "The record and files are publicly accessible.", "embargo_date_l10n": null, "icon": "unlock", "id": "open", "message_class": "", "title_l10n": "Open"}, "created_date_l10n_long": "April 10, 2023", "creators": {"affiliations": [[1, "Universitas PGRI Mahadewa Indonesia", null]], "creators": [{"affiliations": [[1, "Universitas PGRI Mahadewa Indonesia"]], "person_or_org": {"family_name": "Ni Putu Diah Apriyantini", "name": "Ni Putu Diah Apriyantini", "type": "personal"}}, {"affiliations": [[1, "Universitas PGRI Mahadewa Indonesia"]], "person_or_org": {"family_name": "I Komang Sukendra", "name": "I Komang Sukendra", "type": "personal"}}]}, "custom_fields": {"journal:journal": {"issue": "1", "pages": "55 - 63", "title": "Widyadari", "volume": "24"}}, "description_stripped": "Differentiated learning is learning that is designed with the aim of facilitating all the diversity of students based on the learning needs and characteristics of students in learning activities. E-LKPD in the form ofLive Worksheet is one of the media assisted by electronic media which contains text, images, animations, and videos that are more effective so that students don\u0027t get bored quickly. The purpose of this study was to find out whether the application of E-LKPD-assisted differentiated learning can increase students\u0027 active learning in mathematics. This type of research is Classroom Action Research. The subjects of this research were class VIII.2 students of SMP Negeri 6 Denpasar in the academic year 2022/2023 and the object of this research was the activeness of students learning mathematics. In this research through two cycles consisting of four stages of the activity process which includes (1) planning, (2) action, (3) observation, and (4) evaluation and reflection. Data collection techniques using the observation method. The results of the study show that the application of E-LKPD-assisted differentiated learning can increase the activeness of learning mathematics in class VIII.2 students of SMP Negeri 6 Denpasar in the 2022/2023 academic year.", "is_draft": false, "publication_date_l10n_long": "April 10, 2023", "publication_date_l10n_medium": "Apr 10, 2023", "publishing_information": {"journal": "Widyadari, 24(1), 55 - 63, 2023."}, "resource_type": {"id": "publication-article", "title_l10n": "Journal article"}, "rights": [{"description_l10n": "The Creative Commons Attribution license allows re-distribution and re-use of a licensed work on the condition that the creator is appropriately credited.", "icon": "cc-by-icon", "id": "cc-by-4.0", "props": {"scheme": "spdx", "url": "https://creativecommons.org/licenses/by/4.0/legalcode"}, "title_l10n": "Creative Commons Attribution 4.0 International"}], "updated_date_l10n_long": "July 12, 2024", "version": "v1"}, "updated": "2024-07-12T08:15:24.857542+00:00", "versions": {"index": 1, "is_latest": true}}' data-preview='false'>
