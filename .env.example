# PENTING: apa pun yang berawalan VITE_ ikut masuk ke dalam bundel JavaScript
# dan bisa dibaca siapa pun yang membuka aplikasi. Jangan pernah menaruh kunci
# API di variabel VITE_. Kunci hanya boleh di variabel server (tanpa VITE_).

# Copilot AI — dipakai server (Vercel Functions), TIDAK ikut ke browser
GOROUTER_API_KEY=your-gorouter-key
GOROUTER_BASE_URL=https://gorouter.app/v1
GOROUTER_MODEL=claude-opus-5

# Supabase (aman di klien: publishable/anon key memang untuk publik)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Opsional, untuk memakai 9Router di laptop sendiri saat `npm run dev`.
# Kunci tidak disertakan di sini dengan sengaja — isi lewat menu Pengaturan.
VITE_NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
VITE_NINEROUTER_MODEL=cx/gpt-5.6-sol
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini
