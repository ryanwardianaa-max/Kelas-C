# 9Router Local Configuration (opsional, hanya untuk provider "local" di laptop)
VITE_NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
VITE_NINEROUTER_MODEL=cx/gpt-5.6-sol

# Copilot Opus 5 lewat proxy server. Kunci ini HANYA di env server Vercel,
# tanpa prefix VITE_ supaya tidak ikut ke bundel JavaScript.
GOROUTER_API_KEY=your-gorouter-key
# GOROUTER_BASE_URL=https://gorouter.app/v1   (opsional, sudah default)
# GOROUTER_MODEL=claude-opus-5                (opsional, sudah default)

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
