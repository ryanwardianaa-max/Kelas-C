# 9Router Local Configuration (opsional, hanya untuk provider "local" di laptop)
VITE_NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
VITE_NINEROUTER_MODEL=cx/gpt-5.6-sol

# Kunci penyedia AI untuk proxy /api/chat/completions. HANYA di env server
# Vercel, tanpa prefix VITE_ supaya tidak ikut ke bundel JavaScript.
# Daftar model dan vendornya ada di ai-catalog.mjs.
GOROUTER_API_KEY=your-gorouter-key
XKIRO_API_KEY=your-xkiro-key

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
